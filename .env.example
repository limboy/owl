APPLE_TEAM_ID=
APPLE_ID=
SIGNING_IDENTITY_NAME=

# Optional. A The Movie Database v3 API key, baked into the app bundle so
# metadata sync can look up what a video is. Without one the feature is shown
# as unavailable and everything else works unchanged.
#
# Run scripts/write-local-config.sh after setting this. That writes
# Owl/Support/Local.xcconfig, which is what gets the key into a plain
# `xcodebuild`, the Run button in Xcode, and skills/install-to-local.
# scripts/release.sh reads this file directly and needs no such step.
#
# Note that OWL_TMDB_API_KEY — the runtime override — cannot be set here. It is
# read from the environment of the running app, which a file the build never
# loads is not part of; use an Xcode scheme environment variable for that.
TMDB_API_KEY=

# Also required for notarization:
# xcrun notarytool store-credentials "AC_PASSWORD" --apple-id "$APPLE_ID" --team-id "$APPLE_TEAM_ID" --password "<app-specific-password>"
